*Simulations
.control
  
  *set filetype=ascii
  *load /tmp/pwl_lna_input.txt
  

  reset
  tran 1u 0.8s
  setplot tran1
  plot v(vsen) v(vout) 
  write opamp_closeloop_tran1.raw vsen vout
  
  reset
  op
  setplot op1
  print vout  
  write opamp_closeloop_op1_v3_fctoday.raw
  
.endc

