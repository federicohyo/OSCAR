B 5 -152.5 -32.5 -147.5 -27.5 {name=syn_addr_in[0:3] dir=in}
L 4 -150 -30 -130 -30 {}
T {syn_addr_in[0:3]} -125 -34 0 0 0.2 0.2 {}
B 5 -152.5 -12.5 -147.5 -7.5 {name=nRes dir=in}
L 4 -150 -10 -130 -10 {}
T {nRes} -125 -14 0 0 0.2 0.2 {}
B 5 147.5 -32.5 152.5 -27.5 {name=neu_addr_latched[0:3] dir=out}
L 4 130 -30 150 -30 {}
T {neu_addr_latched[0:3]} 125 -34 0 1 0.2 0.2 {}
B 5 -152.5 7.5 -147.5 12.5 {name=neu_addr_in[0:3] dir=in}
L 4 -150 10 -130 10 {}
T {neu_addr_in[0:3]} -125 6 0 0 0.2 0.2 {}
B 5 147.5 -12.5 152.5 -7.5 {name=exc_latched dir=out}
